#!/usr/sbin/nft -f
# Replace only our table in one transaction, preserving Incus and host rules.
destroy table inet garm
table inet garm {
    # Populate with the controller's stable Tailscale IPv4 before activation.
    set controller_ipv4 {
        type ipv4_addr
    }

    set private_ipv4 {
        type ipv4_addr
        flags interval
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
                     169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
                     192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24,
                     203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 }
    }

    chain input {
        type filter hook input priority -50; policy accept;
        # DHCP is the only runner service on Mercury; DNS goes to public resolvers.
        iifname "garmbr0" meta nfproto ipv4 udp sport 68 udp dport 67 accept
        iifname "garmbr0" drop
        iifname "tailscale0" ip saddr @controller_ipv4 tcp dport 8443 accept
        tcp dport 8443 drop
    }

    chain forward {
        type filter hook forward priority -50; policy accept;
        iifname "garmbr0" meta nfproto ipv6 drop
        iifname "garmbr0" ip daddr @private_ipv4 drop
        iifname "garmbr0" oifname "tailscale0" drop
        iifname "garmbr0" oifname "garmbr0" drop
        oifname "garmbr0" ct state established,related accept
        oifname "garmbr0" drop
    }
}
