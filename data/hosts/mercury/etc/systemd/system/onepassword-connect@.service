[Unit]
Description=1Password Connect for %i
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/home/%i/.config/services/onepassword-connect

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/var/home/%i/.config/services/onepassword-connect
ExecStart=/usr/bin/podman-compose --file compose.yaml up --detach
ExecStop=/usr/bin/podman-compose --file compose.yaml stop

[Install]
WantedBy=multi-user.target
