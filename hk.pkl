amends "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Builtins.pkl"

// Shared Mise check tasks cover Actions, formatting, shell and whitespace.
steps {
  ["butane"] = new Step {
    glob = List("data/**", "locals.tf", "templates/hosts/**", "scripts/read_inventory.sh", "scripts/render_hosts.sh")
    check = "scripts/render_hosts.sh --check"
  }
  ["check-added-large-files"] = (Builtins.check_added_large_files) {
    check = "hk util check-added-large-files --maxkb=1024 {{files}}"
  }
  ["cluster-settings"] = new Step {
    glob = List("clusters/**", "inventory.json", "scripts/render_cluster_settings.sh")
    check = "temporary_directory=$(mktemp -d); trap 'rm -rf -- \"$temporary_directory\"' EXIT; scripts/render_cluster_settings.sh \"$temporary_directory\" && diff -ru clusters \"$temporary_directory\""
    fix = "scripts/render_cluster_settings.sh clusters"
  }
  ["detect-private-key"] = Builtins.detect_private_key
  ["inventory"] = new Step {
    local render = "scripts/read_inventory.sh | jq -e .inventory | oxfmt --stdin-filepath inventory.json"
    glob = List("data/**", "inventory.json", "locals.tf", "scripts/read_inventory.sh")
    check = "bash -o pipefail -c '\(render) | diff -u inventory.json -'"
    fix = """
      bash -e -o pipefail -c '
        inventory=$(\(render))
        printf "%s\\n" "$inventory" >inventory.json
      '
      """
  }
  ["tofu"] = Builtins.tofu
  ["tofu-validate"] = new Step {
    glob = List("*.tf", ".terraform.lock.hcl", "data/**")
    check = "tofu validate"
  }
}
