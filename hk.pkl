amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

// Shared Mise check tasks cover Actions, formatting, shell and whitespace.
steps {
  ["butane"] = new Step {
    glob = List("data/access.yaml", "data/machines.yaml", "data/hosts/**", "templates/hosts/**", "scripts/render_hosts.sh")
    check = "scripts/render_hosts.sh --check"
  }
  ["check-added-large-files"] = (Builtins.check_added_large_files) {
    check = "hk util check-added-large-files --maxkb=1024 {{files}}"
  }
  ["detect-private-key"] = Builtins.detect_private_key
  ["tofu"] = Builtins.tofu
  ["tofu-validate"] = new Step {
    glob = List("*.tf", ".terraform.lock.hcl", "data/**")
    check = "tofu validate"
  }
}
