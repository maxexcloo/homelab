amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Builtins.pkl"

// Shared Mise check tasks cover Actions, formatting, shell and whitespace.
steps {
  ["butane"] = new Step {
    glob = "hosts/**"
    check = "for config in hosts/*/*.bu; do butane --files-dir hosts --strict \"$config\" > /dev/null || exit 1; done"
  }
  ["check-added-large-files"] = (Builtins.check_added_large_files) {
    check = "hk util check-added-large-files --maxkb=1024 {{files}}"
  }
  ["detect-private-key"] = Builtins.detect_private_key
  ["tofu"] = Builtins.tofu
  ["tofu-validate"] = new Step {
    glob = List("*.tf", ".terraform.lock.hcl", "data/**")
    check = "tofu validate"
  }
}
