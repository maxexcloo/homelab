variant: fcos
version: 1.6.0

kernel_arguments:
  should_exist:
    - fbcon=rotate:3
    - quiet
    - systemd.show_status=false

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIaF+DCJq1CyGrafKzDMtNjW02M5XJoH5MLFFSlHPjyz Max Schaefer
        # Kimbap pushes the ComfyUI model library and pulls Studio's staged files.
        - restrict,command="/var/home/core/.local/bin/ai-sync-rsync" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINSF/XgIGlHjO79F6qvkna9yLEGslfMqLMC53/i1+obi kimbap AI sync

storage:
  directories:
    - mode: 0754
      path: /etc/ucore-autorebase
  files:
    - mode: 0644
      path: /etc/tailscale-udp-gro-interface
      contents:
        inline: |
          enp3s0
    - mode: 0644
      path: /etc/ucore-autorebase/image.env
      contents:
        inline: |
          UCORE_IMAGE=ghcr.io/ublue-os/ucore-hci:stable
    - mode: 0644
      overwrite: true
      path: /etc/hostname
      contents:
        inline: |
          bento
    - mode: 0644
      path: /var/home/core/.config/btop/btop.conf
      contents:
        local: bento/btop.conf
      group:
        name: core
      user:
        name: core
    - mode: 0755
      path: /var/home/core/.local/bin/ai-sync-rsync
      contents:
        local: bento/ai-sync-rsync.sh
      group:
        name: core
      user:
        name: core
    - mode: 0644
      path: /var/home/core/.trcc/trcc.json
      contents:
        local: bento/trcc.json
      group:
        name: core
      user:
        name: core
    - mode: 0644
      path: /var/lib/systemd/linger/core
      contents:
        inline: ""
  links:
    - path: /var/home/core/.config/systemd/user/default.target.wants/trccd.service
      target: /etc/systemd/user/trccd.service
      group:
        name: core
      user:
        name: core
  trees:
    - local: common/etc
      path: /etc
    - local: bento/etc
      path: /etc

systemd:
  units:
    - name: bento-display-packages.service
      enabled: true
      contents: |
        [Unit]
        Description=Install Bento Display Packages
        After=network-online.target rpm-ostreed.service
        ConditionPathExists=/etc/ucore-autorebase/signed
        ConditionPathExists=!/etc/ucore-autorebase/displays
        Wants=network-online.target

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/rpm-ostree install --allow-inactive --idempotent btop rocm-smi https://github.com/Lexonight1/thermalright-trcc-linux/releases/download/v9.10.9/trcc-linux-9.10.9-1.fc44.noarch.rpm
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/displays
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target
    - name: btop-display.service
      enabled: true
    - name: cockpit-letsencrypt.timer
      enabled: true
    - name: getty@tty1.service
      enabled: false
    - name: ucore-unsigned-autorebase.service
      enabled: true
    - name: ucore-signed-autorebase.service
      enabled: true
