[Unit]
Description=Bento Studio LAN Firewall
After=firewalld.service network-online.target
Wants=firewalld.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/firewall-cmd --add-rich-rule='rule family="ipv4" source address="10.0.0.0/22" destination address="10.0.0.5" port port="443" protocol="tcp" accept' --zone=FedoraServer
ExecStop=/usr/bin/firewall-cmd --remove-rich-rule='rule family="ipv4" source address="10.0.0.0/22" destination address="10.0.0.5" port port="443" protocol="tcp" accept' --zone=FedoraServer
RemainAfterExit=yes
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
