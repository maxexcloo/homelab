#!/usr/bin/bash
set -Eeuo pipefail

read -r interface < /etc/tailscale-udp-gro-interface

if [[ ${1:-} != "${interface}" ]]; then
  exit 0
fi

case "${2:-}" in
  up|dhcp4-change|dhcp6-change)
    exec /usr/bin/ethtool -K "${interface}" \
      rx-udp-gro-forwarding on \
      rx-gro-list off
    ;;
esac
