variant: fcos
version: 1.6.0

passwd:
  groups:
    - name: kimbap
      gid: 1001
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIaF+DCJq1CyGrafKzDMtNjW02M5XJoH5MLFFSlHPjyz Max Schaefer
    - name: kimbap
      home_dir: /var/home/kimbap
      primary_group: kimbap
      shell: /bin/bash
      uid: 1001
      ssh_authorized_keys:
        - ssh-rsa  root@truenas

storage:
  directories:
    - mode: 0754
      path: /etc/ucore-autorebase
  files:
    - mode: 0644
      path: /etc/tailscale-udp-gro-interface
      contents:
        inline: |
          enp1s0
    - mode: 0644
      path: /etc/ucore-autorebase/image.env
      contents:
        inline: |
          UCORE_IMAGE=ghcr.io/ublue-os/ucore:stable
    - mode: 0440
      overwrite: true
      path: /etc/sudoers.d/coreos-sudo-group
      contents:
        inline: |
          # Sudo requires the user password (replaces the CoreOS passwordless default).
    - mode: 0644
      overwrite: true
      path: /etc/hostname
      contents:
        inline: |
          hotdog
  trees:
    - local: common/etc
      path: /etc
    - local: hotdog/etc
      path: /etc

systemd:
  units:
    - name: cockpit-letsencrypt.timer
      enabled: true
    - name: cockpit.service
      enabled: true
    - name: sanoid.timer
      enabled: true
    - name: tailscaled.service
      enabled: true
    - name: ucore-unsigned-autorebase.service
      enabled: true
    - name: ucore-signed-autorebase.service
      enabled: true
    - name: zfs-scrub-monthly@hotdog.timer
      enabled: true
