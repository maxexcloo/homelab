{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignoreDeps": ["hashicorp/terraform"],
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/(^|/)templates/.+\\.ya?ml\\.tftpl$/"],
      "matchStrings": [
        "(?:^|\\r?\\n)\\s*image:\\s*(?<depName>[^\\s:@]+(?:/[^\\s:@]+)*):(?<currentValue>[^\\s@#]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "versioningTemplate": "docker"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "automerge": true,
      "description": "Automerge passing patch and pin updates",
      "matchUpdateTypes": ["patch", "pin"]
    },
    {
      "description": "Group GitHub Actions updates",
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "Group mise tool updates",
      "groupName": "mise tools",
      "matchManagers": ["mise"]
    },
    {
      "description": "Resolve OpenTofu provider updates from the OpenTofu registry",
      "matchDatasources": ["terraform-module", "terraform-provider"],
      "registryUrls": ["https://registry.opentofu.org"]
    }
  ],
  "pre-commit": {
    "enabled": true
  }
}
