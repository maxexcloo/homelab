{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>maxexcloo/dotfiles//renovate/default.json5"],
  customManagers: [
    {
      customType: "regex",
      datasourceTemplate: "github-releases",
      description: "GitHub release asset URLs, matched whole so every copy of the version changes",
      extractVersionTemplate: "^v?(?<version>.+)$",
      managerFilePatterns: ["/.*/"],
      matchStrings: [
        "https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/v?(?<currentValue>\\d+(?:\\.\\d+)+)/\\S+",
      ],
    },
  ],
  // Cluster versions and their matching clients must change together.
  packageRules: [
    {
      groupName: "Kubernetes",
      matchPackageNames: ["kubernetes/kubernetes"],
    },
    {
      groupName: "Talos",
      matchPackageNames: ["siderolabs/talos"],
    },
  ],
}
