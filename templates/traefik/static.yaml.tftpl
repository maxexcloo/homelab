entryPoints:
  websecure:
    address: ":${port}"
    http:
      middlewares:
        - private@file
      tls: {}
providers:
  docker:
    defaultRule: "Host(`{{ index .Labels \"com.docker.compose.service\" }}.${fqdn}`)"
    endpoint: "tcp://127.0.0.1:2375"
    exposedByDefault: false
    useBindPortIP: true
  file:
    filename: /etc/traefik/dynamic.yaml
