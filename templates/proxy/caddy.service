[Unit]
Description=Private HTTPS Proxy

[Service]
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
ExecStart=%h/.local/share/mise/shims/fnox exec --redact --config /etc/homelab/proxy/fnox.toml --only CLOUDFLARE_API_TOKEN -- /usr/bin/caddy run --config /etc/homelab/proxy/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/homelab/proxy/Caddyfile --adapter caddyfile
Restart=on-failure
UMask=0077

[Install]
WantedBy=default.target
