[Unit]
Description=Private HTTPS Proxy

[Container]
ContainerName=caddy
Image=caddy.build
Network=host
Secret=caddy-cloudflare,type=env,target=CLOUDFLARE_API_TOKEN
Volume=/etc/homelab/proxy:/etc/caddy:ro,Z
Volume=caddy-data:/data:Z
Volume=caddy-config:/config:Z

[Service]
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
ExecStartPre=%h/.local/share/mise/shims/fnox exec --config /etc/homelab/proxy/fnox.toml --only CLOUDFLARE_API_TOKEN -- /etc/homelab/proxy/create-secret.sh
ExecReload=/usr/bin/podman exec caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
