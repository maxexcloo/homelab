[Unit]
Description=Browser Automation

[Container]
ContainerName=browserless
Image=${image}
Environment=CONCURRENT=4
Environment=HOST=127.0.0.1
Environment=PORT=${port}
Environment=QUEUED=4
Environment=TIMEOUT=3600000
Network=host
ShmSize=1g

[Service]
ExecStartPre=/usr/bin/install -Dm0600 /etc/homelab/proxy/agent-browser.json %h/.agent-browser/config.json
Restart=on-failure

[Install]
WantedBy=default.target
