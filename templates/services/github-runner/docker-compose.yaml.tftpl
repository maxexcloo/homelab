services:
  %{~ for runner_key, runner in service.data.runners }
  ${runner_key}:
    image: ghcr.io/actions/actions-runner:2.336.0
    restart: unless-stopped
    command:
      - /bin/bash
      - -ec
      - |
        registration_token="$$(
          curl --fail --silent --show-error \
            --request POST \
            --header "Accept: application/vnd.github+json" \
            --header "Authorization: Bearer $${GITHUB_RUNNER_TOKEN}" \
            --header "X-GitHub-Api-Version: 2026-03-10" \
            "https://api.github.com/repos/$${GITHUB_REPOSITORY}/actions/runners/registration-token" |
            sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
        )"
        test -n "$${registration_token}"
        ./config.sh \
          --disableupdate \
          --ephemeral \
        %{~ if length(runner.labels) > 0 }
          --labels "$${RUNNER_LABELS}" \
          --no-default-labels \
        %{~ endif }
          --name "${runner_key}-$${HOSTNAME}" \
          --replace \
          --token "$${registration_token}" \
          --unattended \
          --url "https://github.com/$${GITHUB_REPOSITORY}"
        unset GITHUB_RUNNER_TOKEN
        exec ./run.sh
    environment:
    %{~ for environment_name, environment_value in merge(
      {
        GITHUB_REPOSITORY = service.data.repository
      },
      length(runner.labels) > 0 ? {
        RUNNER_LABELS = join(",", runner.labels)
      } : {},
      {
        for environment_name, credential_name in runner.credential_environment :
        environment_name => service.runtime.credentials[credential_name]
      },
    ) }
      ${environment_name}: ${environment_value}
    %{~ endfor }
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /home/runner/_diag
      - /home/runner/_work
    %{~ if length(runner.mounts) > 0 }
    volumes:
      %{~ for mount in runner.mounts }
      - ${mount}
      %{~ endfor }
    %{~ endif }
  %{~ endfor }
