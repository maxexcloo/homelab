{
  "values": {
    "TZ": "${defaults.system.timezone}",
    "bookorbit": {
      "bootstrap_token": "${service.runtime.credentials.bootstrap_token}",
      "db_password": "${service.runtime.credentials.db_password}",
      "jwt_secret": "${service.runtime.credentials.jwt_secret}",
      "postgres_image_selector": "postgres_18_image"
    },
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": ${service.routing.host_port}
      }
    },
    "storage": {
      "book_drop": {
        "type": "host_path",
        "host_path_config": {
          "acl_enable": false,
          "path": "/mnt/truenas-nvme/bookorbit/bookdrop"
        }
      },
      "books": {
        "type": "host_path",
        "host_path_config": {
          "acl_enable": false,
          "path": "/mnt/truenas-nvme/bookorbit/books"
        }
      },
      "data": {
        "type": "ix_volume",
        "ix_volume_config": {
          "acl_enable": false,
          "dataset_name": "data"
        }
      },
      "postgres_data": {
        "type": "ix_volume",
        "ix_volume_config": {
          "acl_enable": false,
          "dataset_name": "postgres_data"
        }
      }
    }
  }
}
